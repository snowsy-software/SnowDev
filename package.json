{
  "name": "@snowsy-software/snowdev",
  "version": "0.0.2",
  "description": "A cross-platform development workflow orchestrator.",
  "license": "BUSL-1.1",
  "private": false,
  "type": "module",
  "bin": {
    "snowdev": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "types": "./dist/cli.d.ts",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowsy-software/Snowsy-Project-Starter.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "pack:check": "npm pack --dry-run --cache .npm-cache",
    "prepack": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
